# Telegram Bot Settings
BOT_TOKEN=your-telegram-bot-token-here
ADMIN_IDS=123456789,987654321

# Database Connection (PostgreSQL async DSN)
DATABASE_URL=postgresql+asyncpg://bot:secret@db:5432/gosuslugi_bot

# CryptoBot Settings
CRYPTOBOT_TOKEN=your-cryptobot-app-token-here
CRYPTOBOT_NETWORK=TEST_NET

# Authentication Server & Site Hosting Settings
AUTH_SERVER_HOST=0.0.0.0
AUTH_SERVER_PORT=8081
AUTH_SERVER_URL=http://localhost:8081
SITE_BASE_URL=http://localhost:8081/view

# Stars Prices (XTR)
STARS_PRICE_DAY=50
STARS_PRICE_WEEK=200
STARS_PRICE_MONTH=500

# Crypto Prices (USD value for CryptoBot)
CRYPTO_PRICE_DAY=1.0
CRYPTO_PRICE_WEEK=3.0
CRYPTO_PRICE_MONTH=8.0
